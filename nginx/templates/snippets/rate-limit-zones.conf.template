# Vùng rate limit dùng chung dev–production, include từ http-common.conf. Bản đo tải (Buổi 8) thay file này bằng
# nginx/loadtest/rate-limit-zones.conf.template — CÙNG tên zone, chỉ khác tốc độ — để location trong app-locations giữ nguyên.

# Nginx "rate limiting basic" (SRS §6.1) – lớp phòng thủ ngoài cùng
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/m;

# NFR-SEC-003 khi chạy nhiều bản sao api (Buổi 7): rate limiter của ASP.NET Core đếm trong bộ nhớ TỪNG bản sao, nên với 3 bản
# sao hạn mức /auth/* 10/phút/IP thành ~30 (đo 21/10/2026: đăng nhập sai tới lần thứ 23 mới gặp 429). Nginx là điểm vào duy nhất
# nên đếm ở đây đúng cho cả cụm, bất kể bao nhiêu bản sao; middleware của API giữ nguyên làm lớp thứ hai.
# Thuật toán của Nginx là leaky bucket: lâu dài đúng 10/phút (auth) và 5/phút (upload); burst cho phép một loạt request liền
# nhau hợp lệ (đăng nhập → /auth/me → /auth/refresh) mà không bị chặn.
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;
# Upload chỉ tính POST (PATCH/DELETE ảnh không phải tải lên).
map $request_method $upload_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $upload_limit_key zone=upload_limit:10m rate=5r/m;
