# Phần cấp "http" dùng chung cho bản dev (nginx/templates/nginx.conf.template) và production
# (nginx/prod/nginx.conf.template). Là template để entrypoint của nginx:alpine chép sang /etc/nginx/snippets/ (chỉ file
# *.template được xử lý); file này không có biến nào cần thay.

include       /etc/nginx/mime.types;
default_type  application/octet-stream;
sendfile      on;
keepalive_timeout 65;
server_tokens off;

# NFR-PERF-005: nén text/JSON/JS/CSS. gzip_proxied any: nén cả phản hồi từ upstream; gzip_vary: báo cache trung gian
# rằng nội dung đổi theo Accept-Encoding.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml text/javascript application/javascript application/json
           application/problem+json application/xml application/rss+xml application/manifest+json image/svg+xml;

# CONS-007 giới hạn FILE ảnh 5MB – kiểm tra chính xác ở API (400 FILE_SIZE_EXCEEDED).
# Body multipart = file + boundary/header, nên để 5m thì ảnh hợp lệ gần 5MB bị Nginx chặn 413 dạng HTML.
# 10m khớp RequestSizeLimit của endpoint /files/upload (FilesEndpoints.MaxRequestBodyBytes).
client_max_body_size 10m;

# Vùng rate limit (SRS §6.1, NFR-SEC-003) nằm ở snippet riêng để môi trường đo tải (docker-compose.loadtest.yml — Buổi 8) thay
# được bằng nginx/loadtest/rate-limit-zones.conf.template mà không phải sửa file này.
include /etc/nginx/snippets/rate-limit-zones.conf;

# DNS nội bộ Docker: phân giải lại tên service mỗi 10s. Nếu dùng "upstream { server api:8080; }"
# Nginx chỉ phân giải một lần lúc khởi động → container api/frontend được tạo lại (đổi IP) sẽ gây 502 (MT-50).
# Với --scale api=3, Docker DNS trả về mọi bản sao và Nginx tự luân phiên; bản sao mới được nhận trong ≤ 10 giây.
resolver 127.0.0.11 valid=10s ipv6=off;

# Kết nối tới container trong mạng Docker mất < 1 ms. Khi một bản sao api vừa bị gỡ (tools/deploy/rolling-update-api.sh), Nginx có
# thể còn giữ IP cũ trong ≤ 10 giây (valid=10s); SYN tới IP không còn tồn tại bị bỏ lặng lẽ nên kết nối TREO tới hết
# proxy_connect_timeout — mặc định 60 giây (đo 21/10/2026: ab 10 kết nối đồng thời gặp request treo > 15 giây). 2 giây: bỏ
# địa chỉ chết nhanh rồi proxy_next_upstream chuyển sang bản sao còn sống.
proxy_connect_timeout 2s;

map $http_x_correlation_id $correlation_id {
    default $http_x_correlation_id;
    ""      $request_id;
}

# D-14 (Buổi 7): cache ảnh của /media/ ngay tại Nginx — mỗi ảnh chỉ đọc từ MinIO một lần trong 30 ngày. Tên object do server
# sinh ({folder}/{Guid}{ext} — FR-FILE-001) nên nội dung của một URL không bao giờ đổi.
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media:10m max_size=1g inactive=30d use_temp_path=off;
