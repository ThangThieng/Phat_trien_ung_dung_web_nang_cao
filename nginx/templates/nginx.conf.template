# Development reverse proxy. Bản production (HTTPS, HSTS) hoàn thiện ở Buổi 7.
#
# ĐÂY LÀ TEMPLATE, KHÔNG phải file cấu hình cuối cùng. Image nginx:alpine chạy envsubst lúc khởi động
# và ghi kết quả ra /etc/nginx/nginx.conf (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx).
# NGINX_ENVSUBST_FILTER=^HANGFIRE_ giới hạn phạm vi thay thế đúng các biến HANGFIRE_*, nên mọi biến
# của chính Nginx ($host, $remote_addr, $binary_remote_addr…) được giữ nguyên.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    # CONS-007 giới hạn FILE ảnh 5MB – kiểm tra chính xác ở API (400 FILE_SIZE_EXCEEDED).
    # Body multipart = file + boundary/header, nên để 5m thì ảnh hợp lệ gần 5MB bị Nginx chặn 413 dạng HTML.
    # 10m khớp RequestSizeLimit của endpoint /files/upload (FilesEndpoints.MaxRequestBodyBytes).
    client_max_body_size 10m;

    # Nginx "rate limiting basic" (SRS §6.1) – lớp phòng thủ ngoài cùng
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/m;

    # DNS nội bộ Docker: phân giải lại tên service mỗi 10s. Nếu dùng "upstream { server api:8080; }"
    # Nginx chỉ phân giải một lần lúc khởi động → container api/frontend được tạo lại (đổi IP) sẽ gây 502.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_x_correlation_id $correlation_id {
        default $http_x_correlation_id;
        ""      $request_id;
    }

    server {
        listen 80;
        server_name _;

        # proxy_pass dùng biến để buộc Nginx phân giải qua resolver ở runtime
        set $api_upstream      http://api:8080;
        set $frontend_upstream http://frontend:3000;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        location /api/ {
            limit_req zone=api_limit burst=20 nodelay;
            limit_req_status 429;
            # Body > 10m: trả RFC 7807 JSON thay vì trang HTML mặc định để Frontend đọc được lỗi
            error_page 413 @payload_too_large;
            proxy_pass $api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Correlation-ID $correlation_id;
        }

        location @payload_too_large {
            default_type application/problem+json;
            return 413 '{"type":"FILE_SIZE_EXCEEDED","title":"Content Too Large","status":413,"detail":"Kích thước file vượt quá giới hạn 5MB."}';
        }

        # FR-JOB-001 / MT-39: Hangfire Dashboard là trang HTML mở thẳng trong trình duyệt nên không đính kèm
        # được header Authorization: Bearer, mà SRS §5.2 lại loại bỏ cookie → bảo vệ bằng HTTP Basic Auth tại đây.
        # Khối này phải đứng TRƯỚC khối regex bên dưới: Nginx ưu tiên prefix match dài nhất chỉ khi không có
        # regex nào khớp, nên nếu thiếu khối riêng này thì /hangfire rơi vào khối regex và mất Basic Auth.
        location /hangfire {
            auth_basic           "Hangfire Dashboard Restricted";
            auth_basic_user_file /etc/nginx/.htpasswd;

            # Lớp bảo vệ thứ hai (NginxGateDashboardFilter): secret chỉ Nginx biết và chỉ được gắn SAU khi
            # người dùng đã qua Basic Auth. Nhờ đó gọi thẳng http://localhost:5000/hangfire (cổng dev của
            # container api, bỏ qua Nginx) vẫn bị API trả 401.
            proxy_set_header     X-Hangfire-Gate ${HANGFIRE_GATE_SECRET};

            proxy_pass           $api_upstream;
            proxy_http_version   1.1;
            proxy_set_header     Host $host;
            proxy_set_header     X-Real-IP $remote_addr;
            proxy_set_header     X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header     X-Forwarded-Proto $scheme;
        }

        location ~ ^/(health|scalar|openapi) {
            proxy_pass $api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /_next/static/ {
            proxy_pass $frontend_upstream;
            expires 365d;
            add_header Cache-Control "public, immutable";
        }

        location / {
            proxy_pass $frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
