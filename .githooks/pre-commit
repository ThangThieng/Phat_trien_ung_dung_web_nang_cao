#!/bin/sh
# NFR-SEC-007: quét secret trước khi commit bằng gitleaks (chạy qua Docker, không cần cài local)
if ! docker info >/dev/null 2>&1; then
  echo "[gitleaks] Docker chưa chạy – bỏ qua quét secret. Hãy bật Docker Desktop." >&2
  exit 0
fi

# Git Bash (Windows) tự đổi đường dẫn dạng /repo thành C:/Program Files/Git/repo → tắt chuyển đổi.
# Đường dẫn host: "pwd -W" trả D:/... trên Git Bash; Linux/macOS không có -W nên dùng pwd thường.
export MSYS_NO_PATHCONV=1
repo_dir=$(pwd -W 2>/dev/null || pwd)

# git worktree (D:/b6, D:/b34…): file .git của worktree chỉ ghi "gitdir: <repo chính>/.git/worktrees/<tên>" — đường dẫn
# host đó không tồn tại trong container, gitleaks lỗi git rồi vẫn báo "no leaks found" sau khi quét 0 byte.
# Gắn thêm thư mục .git chung và trỏ GIT_DIR/GIT_WORK_TREE để quét đúng phần đã stage của worktree.
git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
set -- -v "$repo_dir:/repo"
if [ "$git_dir" != "$common_dir" ]; then
  set -- "$@" -v "$common_dir:/gitcommon" -e "GIT_DIR=/gitcommon/${git_dir#"$common_dir"/}" -e GIT_WORK_TREE=/repo
fi

docker run --rm "$@" -w /repo zricethezav/gitleaks:latest \
  git --staged --redact --no-banner --config /repo/.gitleaks.toml
status=$?

# gitleaks trả 1 khi tìm thấy secret; mã khác (125/126/127…) là lỗi chạy Docker/gitleaks
if [ $status -eq 1 ]; then
  echo "[gitleaks] Phát hiện secret trong thay đổi đã stage – commit bị chặn." >&2
elif [ $status -ne 0 ]; then
  echo "[gitleaks] Không chạy được gitleaks (mã lỗi $status) – commit bị chặn. Kiểm tra Docker rồi thử lại." >&2
fi
exit $status
