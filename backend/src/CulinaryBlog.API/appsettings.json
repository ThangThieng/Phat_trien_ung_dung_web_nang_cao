{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlog.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "MinIO": {
    "Endpoint": "",
    "PublicBaseUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "culinary-blog",
    "MaxFileSizeBytes": 5242880
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "FromAddress": "no-reply@culinaryblog.com",
    "FromName": "Culinary Blog",
    "SiteUrl": "http://localhost:3000"
  },
  "Seed": {
    "Enabled": false,
    "AdminEmail": "admin@culinaryblog.local"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Hangfire": {
    "WorkerOnly": false,
    "ServerEnabled": true,
    "DashboardPath": "/hangfire",
    "PollIntervalSeconds": 15,
    "DashboardGateSecret": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "General": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Upload": { "PermitLimit": 5, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "TrustedNetworks": [ "172.16.0.0/12" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Seq": {
    "ServerUrl": ""
  },
  "OpenTelemetry": {
    "ServiceName": "culinaryblog-api",
    "OtlpEndpoint": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/culinaryblog-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
