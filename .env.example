# Copy thành .env (KHÔNG commit .env – NFR-SEC-007). Giá trị dưới đây chỉ dùng cho local dev.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL 16
POSTGRES_DB=culinaryblog
POSTGRES_USER=culinary
POSTGRES_HOST_PORT=5432   # đổi (ví dụ 5434) nếu máy đã cài PostgreSQL chiếm cổng 5432
POSTGRES_PASSWORD=change_me_pg

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
# D-14 (Buổi 7): URL công khai của ảnh — Nginx /media/ chuyển tới bucket culinary-blog. Trình duyệt và container cùng dùng
# địa chỉ này (không còn http://localhost:9000). Ảnh đã lưu với URL cũ: chạy tools/media-url-migration/migrate-media-urls.sh.
MEDIA_PUBLIC_URL=http://localhost/media

# JWT HS256 – tối thiểu 64 ký tự ngẫu nhiên:  openssl rand -base64 64
JWT_SIGNING_KEY=

# Seed dữ liệu mẫu (SRS §2.6.1) – mật khẩu admin@culinaryblog.local và author1..5@culinaryblog.local
SEED_ADMIN_PASSWORD=
SEED_AUTHOR_PASSWORD=

# Google OAuth 2.0 (FR-AUTH-003) — Client ID của nhóm (dự án Google Cloud "Culinary Blog", origin http://localhost và https://localhost).
# Client ID KHÔNG phải bí mật: Google thiết kế để công khai và nó vẫn hiện trong mã mọi trang có nút Google, nên được ghi sẵn ở đây
# (NFR-SEC-007 chỉ cấm bí mật). Client secret thì không — web chỉ kiểm ID Token nên để trống. Đổi ID → build lại frontend.
GOOGLE_CLIENT_ID=621955829445-h01jimdlcdjut80e93umca9c5v95uk0t.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Auth.js v5:  openssl rand -base64 32
AUTH_SECRET=
REVALIDATE_SECRET=

# Hangfire Dashboard (FR-JOB-001 / MT-39) – bảo vệ bằng Basic Auth ở Nginx + header gate ở API.
# Sau khi điền, chạy:  ./nginx/generate-htpasswd.sh   (Windows: powershell ./nginx/generate-htpasswd.ps1)
# HANGFIRE_GATE_SECRET: chuỗi ngẫu nhiên, ví dụ  openssl rand -hex 32
HANGFIRE_GATE_SECRET=
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=

# CR-2026-10: Frontend gắn bí mật này khi render trang và gọi thẳng API để nạp cache dùng chung; API cho các request đó một hạn mức
# chung riêng (RateLimiting:Render, 1000/phút) thay vì hạn mức theo IP. Chuỗi ngẫu nhiên, ví dụ  openssl rand -hex 32
RENDER_GATE_SECRET=

# SMTP – dev dùng mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false

# URL public
SITE_URL=http://localhost
PUBLIC_API_BASE_URL=/api/v1

# D-14: false = ảnh đi qua Next Image Optimizer (mặc định). true chỉ khi demo mà ảnh MinIO không truy cập được từ container frontend.
IMAGE_UNOPTIMIZED=false
