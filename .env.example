# Copy thành .env (KHÔNG commit .env – NFR-SEC-007). Giá trị dưới đây chỉ dùng cho local dev.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL 16
POSTGRES_DB=culinaryblog
POSTGRES_USER=culinary
POSTGRES_HOST_PORT=5432   # đổi (ví dụ 5434) nếu máy đã cài PostgreSQL chiếm cổng 5432
POSTGRES_PASSWORD=change_me_pg

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_PUBLIC_URL=http://localhost:9000

# JWT HS256 – tối thiểu 64 ký tự ngẫu nhiên:  openssl rand -base64 64
JWT_SIGNING_KEY=

# Seed dữ liệu mẫu (SRS §2.6.1) – mật khẩu admin@culinaryblog.local và author1..5@culinaryblog.local
SEED_ADMIN_PASSWORD=
SEED_AUTHOR_PASSWORD=

# Google OAuth 2.0 (Google Cloud Console → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5:  openssl rand -base64 32
AUTH_SECRET=
REVALIDATE_SECRET=

# SMTP – dev dùng mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false

# URL public
SITE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
