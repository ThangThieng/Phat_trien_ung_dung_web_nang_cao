# Copy thành .env.local khi chạy `npm run dev` ngoài Docker
# URL backend gọi từ trình duyệt
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# URL backend gọi từ server Next.js (SSR/ISR) – trong Docker là http://api:8080/api/v1
API_INTERNAL_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# (Còn lại từ Buổi 2 – SRS v1.1.0 đã chọn ID Token flow, không PKCE, MT-11)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Không dùng ISR (MT-67) – biến này không còn tác dụng
REVALIDATE_SECRET=

# Retrofit D-14: ảnh đi qua next/image. Đặt true chỉ khi container Next.js không với tới địa chỉ ảnh (dev, chưa có Nginx /media/)
NEXT_PUBLIC_IMAGE_UNOPTIMIZED=false
