# Copy thành .env.production rồi `chmod 600 .env.production` (KHÔNG commit — NFR-SEC-007). Dùng cho docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Mọi giá trị dưới đây phải khác bản dev (.env). Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# PostgreSQL 16 (production dùng chung volume pgdata với bản dev của project "culinaryblog" — xem docker-compose.prod.yml)
POSTGRES_DB=culinaryblog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=

# MinIO — không mở cổng 9000/9001 ra máy chủ; ảnh đi qua Nginx /media/ (D-14)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# URL công khai (HTTPS). Domain thật: https://<domain> và https://<domain>/media
SITE_URL=https://localhost
MEDIA_PUBLIC_URL=https://localhost/media
PUBLIC_API_BASE_URL=/api/v1

# JWT HS256 – tối thiểu 64 ký tự ngẫu nhiên:  openssl rand -base64 64
JWT_SIGNING_KEY=

# D-17: mật khẩu của ./ssl/dataprotection.pfx — ./nginx/generate-ssl-cert.sh đọc biến này khi sinh file.
DATAPROTECTION_CERT_PASSWORD=

# Dữ liệu mẫu (CR-2026-03): chỉ bật khi triển khai trình diễn trên cơ sở dữ liệu trống.
SEED_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_AUTHOR_PASSWORD=

# Google OAuth 2.0 — thêm https://<domain> vào Authorized JavaScript origins
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_SECRET=
REVALIDATE_SECRET=

# Hangfire Dashboard (FR-JOB-001 / MT-39): Basic Auth ở Nginx + header gate ở API
#   ENV_FILE=.env.production ./nginx/generate-htpasswd.sh
HANGFIRE_GATE_SECRET=
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=

# SMTP thật (production không có mailhog)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
